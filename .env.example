# ==============================================================================
# GLOBAL THREAT MAP - Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# MAPBOX (REQUIRED)
# ------------------------------------------------------------------------------
# Get your token at: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# ------------------------------------------------------------------------------
# EXA AI — NEWS SEARCH (REQUIRED)
# ------------------------------------------------------------------------------
# Powers all event feeds, entity research, and country conflict data.
# 1,000 searches/month free — sign up at https://exa.ai
EXA_API_KEY=your_exa_api_key_here

# ------------------------------------------------------------------------------
# TAVILY — SEARCH FALLBACK (OPTIONAL BUT RECOMMENDED)
# ------------------------------------------------------------------------------
# Used automatically when Exa's monthly quota is exhausted.
# 1,000 searches/month free — sign up at https://tavily.com
# TAVILY_API_KEY=tvly-your_tavily_key_here

# ------------------------------------------------------------------------------
# ANTHROPIC / CLAUDE (OPTIONAL)
# ------------------------------------------------------------------------------
# Powers three features when set:
#   1. AI event classification — extracts category, threat level & location
#      from news headlines (falls back to regex if not set)
#   2. AI research synthesis — generates summaries for entity/conflict research
#      (falls back to raw search excerpts if not set)
#   3. Image Geolocation — Claude Vision estimates where a photo was taken
#      (falls back to GeoSpy if not set)
# Get your API key at: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001  # Optional: override the default model

# ------------------------------------------------------------------------------
# IMAGE GEOLOCATION — OSINT (OPTIONAL)
# ------------------------------------------------------------------------------
# Powers the "Geolocate Image" feature: drop any photo and the app will
# estimate where it was taken using a 3-step pipeline:
#   1. EXIF GPS metadata  (free, instant)
#   2. Claude Vision AI   (primary AI — needs ANTHROPIC_API_KEY above)
#   3. GeoSpy ML API      (fallback if Claude unavailable, ~$0.01/image)
#
# GeoSpy — sign up at https://geospy.ai (Pro tier required for API access)
# GEOSPY_API_KEY=your_geospy_api_key_here

# ------------------------------------------------------------------------------
# APP MODE (OPTIONAL)
# ------------------------------------------------------------------------------
# Default is 'self-hosted' — just set EXA_API_KEY above and you're ready!
NEXT_PUBLIC_APP_MODE=self-hosted

# ------------------------------------------------------------------------------
# MARITIME AIS — AISSTREAM.IO (OPTIONAL)
# ------------------------------------------------------------------------------
# Enables live vessel tracking via AIS WebSocket stream.
# Free tier available — sign up at https://aisstream.io
# Without this key the Maritime layer will show no vessels.
# NEXT_PUBLIC_AISSTREAM_API_KEY=your_aisstream_key_here
